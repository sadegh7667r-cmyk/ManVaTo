      });
  }
  function avatar(u, size = 38) {
    const name = u ? u.name : '؟';
    return `<span class="avatar" style="background:${safeColor(u && u.color)};width:${size}px;height:${size}px;font-size:${Math.round(size * .4)}px">${esc([...name][0] || '؟')}</span>`;
  }

  /* ---------- ایجاد داده‌ی اولیه ---------- */
  function seed() {
    if (CLOUD && !synced) return;
