  }
  const prefs = uidv => get('prefs:' + uidv, {});
  function setPref(uidv, patch) { set('prefs:' + uidv, { ...prefs(uidv), ...patch }); }

  /* ---------- قالب‌بندی متن ---------- */
  function fmt(text) {
    return esc(text).replace(
      /(https?:\/\/(?:(?!&(?:quot|lt|gt|#39);)[^\s<])+)|(@[A-Za-z0-9_\u0600-\u06FF]{3,20})/g,
