    if (!obj.data.users.some(u => u && u.role === 'admin')) return fail('فایل پشتیبان هیچ مدیری ندارد؛ وارد کردن آن شما را قفل می‌کند.');
    allKeys().forEach(k => { if (!SKIP.test(k)) del(k); });
    let n = 0;
    for (const k in obj.data) { if (SKIP.test(k)) continue; if (set(k, obj.data[k])) n++; }
    cache.clear(); set('seeded', true);
    return ok({ keys: n });
  }
  function resetAll() { allKeys().forEach(k => del(k)); if (CLOUD) pushOps(['users', 'rooms', 'msgs', 'reports', 'logs', 'presence', 'read', 'kv'].map(p => [p, null])); cache.clear(); clearSession(); clearAdminSession(); }

  /* ---------- رابط: تم، اعلان، پنجره ---------- */
  const theme = () => get('theme', 'dark');
  function applyTheme(t) {
    t = t || theme(); document.documentElement.dataset.theme = t;
    const m = document.querySelector('meta[name="theme-color"]'); if (m) m.content = t === 'dark' ? '#090e1b' : '#f1f4fa';
  }
  function setTheme(t) { set('theme', t); applyTheme(t); }

  function el(html) { const t = document.createElement('template'); t.innerHTML = html.trim(); return t.content.firstElementChild; }
  function toast(msg, type = '') {
    let box = document.querySelector('.gk-toasts');
    if (!box) { box = document.createElement('div'); box.className = 'gk-toasts'; box.setAttribute('role', 'status'); document.body.append(box); }
