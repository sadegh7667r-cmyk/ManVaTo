function dashboard() {
  const us = GK.users(), rs = GK.rooms(), reports = GK.get('reports', []).filter(r => r.status === 'open');
  const days = []; const d0 = new Date(); d0.setHours(0, 0, 0, 0);
  for (let i = 6; i >= 0; i--) days.push({ t: d0.getTime() - i * 864e5, n: 0 });
  let total = 0; const per = {};
  rs.forEach(r => GK.msgs(r.id).forEach(m => {
    total++; per[m.userId] = (per[m.userId] || 0) + 1;
    for (let i = 6; i >= 0; i--) if (m.time >= days[i].t) { days[i].n++; break; }
  }));
  const mx = Math.max(1, ...days.map(d => d.n));
  const bars = days.map((d, i) => { const h = Math.round(d.n / mx * 90), x = 14 + i * 58;
    return `<rect x="${x}" y="${110 - h}" width="38" height="${Math.max(2, h)}" rx="7"/><text x="${x + 19}" y="${104 - h}" text-anchor="middle">${fa(d.n)}</text><text x="${x + 19}" y="128" text-anchor="middle">${new Date(d.t).toLocaleDateString('fa-IR', { weekday: 'short' })}</text>`; }).join('');
  const top = Object.entries(per).sort((a, b) => b[1] - a[1]).slice(0, 5);
  const used = GK.usedBytes(), pct = Math.min(100, Math.round(used / (5 * 1024 * 1024) * 100));
  const logs = GK.get('logs', []).slice(0, 7);
  return `<div class="stats">
    ${[['کاربران', us.length], ['آنلاین الان', GK.onlineCount()], ['اتاق‌ها', rs.filter(r => r.type !== 'dm').length], ['پیام‌ها', total], ['گزارش باز', reports.length], ['مسدود', us.filter(u => u.status === 'banned').length]].map(([t, n]) => `<div class="stat"><b>${fa(n)}</b><span>${t}</span></div>`).join('')}</div>
  ${GK.settings().maintenance ? '<div class="card" style="border-color:var(--warn)">⚠️ حالت تعمیر فعال است؛ فقط مدیران می‌توانند وارد شوند.</div>' : ''}
  <div class="grid2"><div class="card"><h3>پیام‌های ۷ روز اخیر</h3><svg class="bars" viewBox="0 0 420 135" role="img" aria-label="نمودار پیام‌های هفت روز اخیر">${bars}</svg></div>
  <div class="card"><h3>فعال‌ترین کاربران</h3>${top.length ? top.map(([id, n]) => { const u = GK.userById(id); return `<div class="li">${GK.avatar(u || { name: '؟' }, 30)}<span class="grow">${esc(u ? u.name : 'حذف‌شده')}</span><b>${fa(n)}</b></div>`; }).join('') : empty('هنوز پیامی نیست.')}</div></div>
  <div class="grid2"><div class="card"><h3>آخرین فعالیت‌ها</h3>${logs.length ? logs.map(l => `<div class="li"><span class="grow">${esc(l.detail || l.action)}</span><span class="muted tiny">${esc(GK.ago(l.t))}</span></div>`).join('') : empty('فعالیتی ثبت نشده.')}</div>
  <div class="card"><h3>فضای ذخیره‌سازی مرورگر</h3><div class="meter"><i style="width:${pct}%"></i></div>
  <p class="small muted" style="margin:8px 0 0">حدود ${fa((used / 1024).toFixed(0))} کیلوبایت از ~۵ مگابایت (${fa(pct)}٪). برای امنیت بیشتر، پشتیبان بگیر.</p>
  ${!GK.persistent ? '<p class="err">ذخیره‌سازی دائمی فعال نیست!</p>' : ''}</div></div>`;
}

