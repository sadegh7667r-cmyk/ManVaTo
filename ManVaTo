<script>
'use strict';
/* گپ‌خانه — هسته‌ی مشترک: ذخیره‌سازی، احراز هویت، اتاق‌ها، پیام‌ها، مدیریت و ابزار رابط */
window.GK = (() => {
  const P = 'gk2:';
  const NAME_RE = /^[A-Za-z0-9_\u0600-\u06FF]{3,20}$/;
  const COLORS = ['#7c5cff', '#089e8d', '#ed6598', '#e99b36', '#3988ef', '#e5534b', '#7cb342', '#00a8cc'];
  const MAX_MSGS_PER_ROOM = 3000;
  const mem = Object.create(null);

  /* ---------- ذخیره‌سازی (محلی + همگام‌سازی آنلاین) ---------- */
  const CLOUD = String(window.GAPKHANE_DB_URL || '').trim().replace(/\/+$/, '');
  const ROOT = 'gapkhane';
  const LOCAL_ONLY = /^(session|attempts|lastsend|theme|prefs:|__)/;
  let skew = 0;
  function probe(s) {
    try { const k = P + '__t'; s.setItem(k, '1'); s.removeItem(k); return s; } catch { return null; }
  }
  let store = null, sess = null;
  try { store = probe(window.localStorage); } catch {}
  try { sess = probe(window.sessionStorage); } catch {}
  const persistent = CLOUD ? true : !!store;
  const useMem = k => !store || (!!CLOUD && !LOCAL_ONLY.test(k));

  const hs = new Set();
  function onChange(fn) { hs.add(fn); return () => hs.delete(fn); }
  window.addEventListener('storage', e => {
    if (store && e.storageArea !== store) return;
    if (e.key === null) { hs.forEach(f => f('*')); return; }
    if (!e.key.startsWith(P)) return;
    const k = e.key.slice(P.length);
    hs.forEach(f => { try { f(k); } catch (err) { console.error(err); } });
  });

  const errHandlers = new Set();
  function onError(fn) { errHandlers.add(fn); }
  function rawGet(key) { return useMem(key) ? (key in mem ? mem[key] : null) : store.getItem(P + key); }
  function get(key, def) {
    try { const v = rawGet(key); return v == null ? def : JSON.parse(v); } catch { return def; }
  }
  function set(key, val) {
    const s = JSON.stringify(val);
    const sync = CLOUD && !LOCAL_ONLY.test(key);
    const old = sync ? get(key, undefined) : undefined;
    try {
      if (useMem(key)) mem[key] = s; else store.setItem(P + key, s);
    } catch (e) {
      errHandlers.forEach(f => f(e)); return false;
    }
    if (sync) pushOps(opsFor(key, old, val));
    return true;
  }
  function del(key) {
    const sync = CLOUD && !LOCAL_ONLY.test(key);
    try { if (useMem(key)) delete mem[key]; else store.removeItem(P + key); } catch {}
    if (sync) pushOps(delOps(key));
  }
  function allKeys() {
    const out = new Set(Object.keys(mem));
    if (store) { for (let i = 0; i < store.length; i++) { const k = store.key(i); if (k && k.startsWith(P)) out.add(k.slice(P.length)); } }
    return [...out];
  }
  function usedBytes() {
    let n = 0;
    allKeys().forEach(k => { n += (rawGet(k) || '').length * 2; });
    return n;
  }

  /* ---------- همگام‌سازی آنلاین (Firebase Realtime Database با REST + SSE) ----------
     هر کاربر، اتاق، پیام و گزارش یک گره‌ی جدا دارد؛ پس دو نفری که هم‌زمان پیام می‌فرستند
     روی هم نمی‌نویسند. تغییرات از طریق جریان زنده (SSE) بدون بارگذاری مجدد می‌رسند. */
  let tree = {}, synced = false, outbox = [], es = null, status = 'connecting', lastEvt = 0;
  let flushing = false, retry = 0, retryT = 0, rcT = 0, rcN = 0, netEl = null;
  let readyRes; const ready = new Promise(r => { readyRes = r; });
  if (!CLOUD) readyRes();
  const statusFns = new Set();
  function onStatus(fn) { statusFns.add(fn); try { fn(status); } catch {} return () => statusFns.delete(fn); }
  function setStatus(s) {
    if (s === status) return;
    status = s; statusFns.forEach(f => { try { f(s); } catch {} }); paintNet();
  }
  function paintNet() {
    if (!CLOUD || !synced) return;
    if (!netEl) { netEl = document.createElement('div'); netEl.className = 'gk-net'; netEl.setAttribute('role', 'status'); document.body.append(netEl); }
