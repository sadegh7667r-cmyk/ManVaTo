<style>
/* گپ‌خانه — استایل مشترک (چت + پنل مدیریت) */
:root{
  color-scheme:dark;
  --bg:#090e1b;--panel:#111a2b;--panel2:#172238;--field:#0d1525;
  --text:#edf3ff;--muted:#8c9bb5;--line:#26334a;
  --accent:#7c5cff;--accent2:#28d7bd;--on-accent:#fff;
  --mine:#6b4df6;--other:#19263b;
  --danger:#ff647c;--ok:#35d399;--warn:#f0a73a;
  --shadow:0 18px 60px #0007;
}
[data-theme="light"]{
  color-scheme:light;
  --bg:#f1f4fa;--panel:#fff;--panel2:#f5f7fc;--field:#f6f8fc;
  --text:#17213a;--muted:#6c7891;--line:#e1e6f0;
  --accent:#6445e8;--accent2:#089e8d;
  --mine:#6445e8;--other:#fff;
  --danger:#d63e5c;--ok:#12906b;--warn:#b9741a;
  --shadow:0 18px 60px #25325220;
}
[data-app="admin"]{--accent:#e8a33d;--on-accent:#1a1204;--mine:#e8a33d}
html[data-theme="light"] [data-app="admin"]{--accent:#c97d12;--on-accent:#fff}

*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{
  font-family:Vazirmatn,Tahoma,sans-serif;background:var(--bg);color:var(--text);
  font-size:14px;line-height:1.8;-webkit-tap-highlight-color:transparent
}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
button:disabled{opacity:.45;cursor:not-allowed}
a{color:var(--accent2)}
[hidden]{display:none!important}
:focus-visible{outline:2px solid var(--accent2);outline-offset:2px}
::selection{background:var(--accent);color:var(--on-accent)}
*{scrollbar-width:thin;scrollbar-color:var(--line) transparent}
.muted{color:var(--muted)}.small{font-size:12px}.tiny{font-size:11px}
.grow{flex:1;min-width:0}.row{display:flex;align-items:center;gap:10px}.wrap{flex-wrap:wrap}
.ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ltr{direction:ltr;unicode-bidi:plaintext}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:9px 15px;border-radius:12px;background:var(--panel2);
  border:1px solid var(--line);transition:transform .12s,filter .12s,background .12s;
  white-space:nowrap
}
.btn:hover:not(:disabled){filter:brightness(1.12)}
.btn:active:not(:disabled){transform:scale(.97)}
.btn.primary{background:var(--accent);color:var(--on-accent);border-color:transparent;font-weight:800}
.btn.danger{background:transparent;color:var(--danger);border-color:color-mix(in srgb,var(--danger) 45%,transparent)}
.btn.danger.solid{background:var(--danger);color:#fff;border-color:transparent}
.btn.ghost{background:transparent;border-color:transparent}
.btn.ghost:hover:not(:disabled){background:var(--panel2);filter:none}
.btn.sm{padding:4px 10px;font-size:12px;border-radius:9px}
.btn.icon-btn{width:40px;height:40px;padding:0}
.btn.block{width:100%}

input,textarea,select{
  width:100%;background:var(--field);border:1px solid var(--line);
  border-radius:12px;padding:10px 13px;outline:none;transition:border-color .15s
}
input:focus,textarea:focus,select:focus{border-color:var(--accent)}
input[type=checkbox],input[type=radio]{width:auto;accent-color:var(--accent)}
textarea{resize:vertical}
label.lbl{display:block;font-weight:700;margin-bottom:6px;font-size:13px}
.field{margin-bottom:15px}
.hint{font-size:11px;color:var(--muted);margin-top:4px}
.err{color:var(--danger);font-size:12px;min-height:20px;margin-top:6px}
.check{display:flex;align-items:center;gap:8px;cursor:pointer}

.avatar{
  display:grid;place-items:center;flex-shrink:0;width:38px;height:38px;
  border-radius:14px;color:#fff;font-weight:900;font-size:15px;text-shadow:0 1px 2px #0004
}
.tag{
  display:inline-block;font-size:10px;font-weight:800;padding:0 7px;border-radius:99px;
  line-height:18px;background:color-mix(in srgb,var(--accent2) 18%,transparent);color:var(--accent2)
}
.tag.admin{background:color-mix(in srgb,var(--warn) 20%,transparent);color:var(--warn)}
.tag.bad{background:color-mix(in srgb,var(--danger) 18%,transparent);color:var(--danger)}
.tag.ok{background:color-mix(in srgb,var(--ok) 18%,transparent);color:var(--ok)}
.dot{width:9px;height:9px;border-radius:50%;background:var(--muted);display:inline-block;flex-shrink:0}
.dot.on{background:var(--ok);box-shadow:0 0 0 3px color-mix(in srgb,var(--ok) 25%,transparent)}

/* پنجره‌ی گفتگو */
.gk-scrim{
  position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:14px;
  background:#050810a8;backdrop-filter:blur(3px);animation:gkfade .14s ease
}
.gk-modal{
  width:min(480px,100%);max-height:92vh;display:flex;flex-direction:column;
  background:var(--panel);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)
}
.gk-modal.wide{width:min(720px,100%)}
.gk-mh{display:flex;align-items:center;justify-content:space-between;padding:16px 20px 6px}
.gk-mh h3{margin:0;font-size:17px;font-weight:900}
.gk-mb{padding:10px 20px 6px;overflow:auto}
.gk-mf{display:flex;justify-content:flex-start;gap:8px;padding:14px 20px 18px;flex-wrap:wrap}
.gk-p{margin:6px 0 10px;white-space:pre-wrap}
@keyframes gkfade{from{opacity:0}to{opacity:1}}

.gk-toasts{
  position:fixed;bottom:22px;left:50%;transform:translateX(-50%);z-index:1100;
  display:flex;flex-direction:column;gap:8px;align-items:center;width:min(92vw,420px);pointer-events:none
}
.gk-toast{
  background:var(--text);color:var(--bg);padding:9px 18px;border-radius:14px;
  box-shadow:var(--shadow);font-size:13px;text-align:center;animation:gkfade .15s ease
}
.gk-toast.error{background:var(--danger);color:#fff}
.gk-toast.ok{background:var(--ok);color:#06150f}

@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

#chatRoot,#adminRoot{height:100%}
body[data-app="chat"] .auth{
  min-height:100%;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,480px);align-items:center;gap:40px;
  padding:32px clamp(18px,6vw,90px);overflow:auto;
  background:radial-gradient(ellipse at 12% 10%,#795cff22,transparent 45%),radial-gradient(ellipse at 90% 90%,#22d3bb14,transparent 40%),var(--bg)
}
body[data-app="chat"] .hero .brand{display:flex;align-items:center;gap:12px;margin-bottom:30px}
body[data-app="chat"] .logo{
  display:grid;place-items:center;width:48px;height:48px;border-radius:17px;color:#fff;font-size:24px;font-weight:900;
  background:linear-gradient(135deg,var(--accent),#bc70ff);box-shadow:0 8px 24px #7c5cff40;flex-shrink:0
}
body[data-app="chat"] .brand-name{font-size:22px;font-weight:900}
body[data-app="chat"] .hero h1{font-size:clamp(28px,4.4vw,46px);line-height:1.5;margin:0 0 12px;font-weight:900;max-width:15em}
body[data-app="chat"] .hero p.lead{color:var(--muted);font-size:15px;max-width:30em;margin:0 0 30px}
body[data-app="chat"] .demo{display:flex;flex-direction:column;gap:9px;max-width:380px}
body[data-app="chat"] .demo .b{padding:9px 14px;border-radius:18px;background:var(--other);border:1px solid var(--line);width:fit-content;max-width:90%}
body[data-app="chat"] .demo .b.me{background:var(--mine);color:#fff;border-color:transparent;align-self:flex-start}
body[data-app="chat"] .demo .b small{display:block;color:var(--accent2);font-weight:800;font-size:11px}
body[data-app="chat"] .demo .b.me small{color:#ffffffb0}
body[data-app="chat"] .auth-card{background:var(--panel);border:1px solid var(--line);border-radius:26px;padding:26px;box-shadow:var(--shadow)}
body[data-app="chat"] .tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:var(--field);border-radius:14px;padding:4px;margin-bottom:22px}
body[data-app="chat"] .tabs button{padding:9px;border-radius:11px;font-weight:800;color:var(--muted)}
body[data-app="chat"] .tabs button[aria-selected=true]{background:var(--panel2);color:var(--text);box-shadow:0 2px 8px #0003}
body[data-app="chat"] .pw{position:relative}
body[data-app="chat"] .pw input{padding-left:46px}
body[data-app="chat"] .pw .eye{position:absolute;left:6px;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:10px;color:var(--muted)}
body[data-app="chat"] .meter{height:5px;border-radius:9px;background:var(--line);margin-top:8px;overflow:hidden}
body[data-app="chat"] .meter i{display:block;height:100%;width:0;transition:width .25s,background .25s}
body[data-app="chat"] .swatches{display:flex;gap:9px;flex-wrap:wrap}
body[data-app="chat"] .swatches button{width:32px;height:32px;border-radius:50%;border:3px solid var(--panel);outline:1px solid var(--line)}
body[data-app="chat"] .swatches button[aria-checked=true]{outline:2px solid var(--accent2)}
body[data-app="chat"] .notice{padding:10px 13px;border-radius:12px;font-size:12px;margin-bottom:16px;background:color-mix(in srgb,var(--warn) 14%,transparent);color:var(--warn)}
body[data-app="chat"] .auth-foot{display:flex;justify-content:space-between;gap:10px;margin-top:18px;font-size:12px;color:var(--muted)}
body[data-app="chat"] .app{height:100%;display:grid;grid-template-columns:320px minmax(0,1fr)}
body[data-app="chat"] .sidebar{min-height:0;background:var(--panel);border-left:1px solid var(--line);display:flex;flex-direction:column;z-index:20}
body[data-app="chat"] .side-head{padding:16px 16px 10px}
body[data-app="chat"] .me{display:flex;align-items:center;gap:10px;padding:10px;border-radius:16px;background:var(--panel2);border:1px solid var(--line)}
body[data-app="chat"] .side-search{padding:0 16px 8px}
body[data-app="chat"] .side-scroll{flex:1;min-height:0;overflow:auto;padding:0 10px 10px}
body[data-app="chat"] .sec{display:flex;align-items:center;justify-content:space-between;padding:12px 8px 5px;font-weight:800;font-size:12px;color:var(--muted)}
body[data-app="chat"] .item{display:flex;align-items:center;gap:10px;width:100%;text-align:right;padding:8px;border-radius:14px}
body[data-app="chat"] .item:hover{background:var(--panel2)}
body[data-app="chat"] .item[aria-current=true]{background:color-mix(in srgb,var(--accent) 18%,transparent)}
body[data-app="chat"] .ricon{display:grid;place-items:center;width:40px;height:40px;border-radius:14px;background:var(--panel2);font-size:20px;flex-shrink:0;border:1px solid var(--line)}
body[data-app="chat"] .item-main{flex:1;min-width:0}
body[data-app="chat"] .item-top{display:flex;justify-content:space-between;gap:6px;align-items:center}
body[data-app="chat"] .item-name{font-weight:800}
body[data-app="chat"] .item-time{font-size:10px;color:var(--muted)}
body[data-app="chat"] .item-last{font-size:12px;color:var(--muted)}
body[data-app="chat"] .badge{min-width:20px;height:20px;padding:0 6px;border-radius:99px;background:var(--accent);color:var(--on-accent);font-size:11px;font-weight:800;display:grid;place-items:center}
body[data-app="chat"] .side-foot{padding:10px;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:6px}
body[data-app="chat"] .side-foot .wide{grid-column:1/-1}
body[data-app="chat"] .scrim{display:none}
body[data-app="chat"] .chat{display:flex;flex-direction:column;min-width:0;min-height:0;position:relative}
body[data-app="chat"] .topbar{display:flex;align-items:center;gap:12px;padding:10px 16px;border-bottom:1px solid var(--line);background:var(--panel)}
body[data-app="chat"] .topbar h2{font-size:16px;margin:0;font-weight:900}
body[data-app="chat"] .mobile-only{display:none}
body[data-app="chat"] .pin{display:flex;align-items:center;gap:10px;padding:7px 16px;background:var(--panel2);border-bottom:1px solid var(--line);cursor:pointer;font-size:12px}
body[data-app="chat"] .searchbar{padding:10px 16px 0}
body[data-app="chat"] .messages{flex:1;min-height:0;overflow-y:auto;padding:16px;overscroll-behavior:contain}
body[data-app="chat"] .feed{width:min(860px,100%);margin:auto;display:flex;flex-direction:column}
body[data-app="chat"] .empty{text-align:center;margin:auto;padding:40px 16px;color:var(--muted)}
body[data-app="chat"] .empty .big{font-size:44px}
body[data-app="chat"] .empty h3{color:var(--text);margin:6px 0}
body[data-app="chat"] .day{align-self:center;border:1px solid var(--line);background:var(--panel);border-radius:99px;padding:2px 13px;font-size:11px;color:var(--muted);margin:14px 0 4px}
body[data-app="chat"] .sys{align-self:center;color:var(--muted);font-size:12px;margin:8px 0;text-align:center}
body[data-app="chat"] .more{align-self:center;margin:6px}
body[data-app="chat"] .message{display:flex;align-items:flex-end;gap:8px;margin-top:10px;max-width:min(82%,600px);align-self:flex-end}
body[data-app="chat"] .message.cont{margin-top:3px}
body[data-app="chat"] .message.mine{align-self:flex-start;flex-direction:row}
body[data-app="chat"] .message .av{width:38px;flex-shrink:0}
body[data-app="chat"] .message.mine .av{display:none}
body[data-app="chat"] .mbody{min-width:0;display:flex;flex-direction:column}
body[data-app="chat"] .mhead{font-size:12px;font-weight:900;margin:0 10px 3px;display:flex;gap:6px;align-items:center}
body[data-app="chat"] .mhead button{font-weight:900}
body[data-app="chat"] .bubble{padding:8px 13px 5px;border-radius:18px;background:var(--other);border:1px solid var(--line);overflow-wrap:anywhere;white-space:pre-wrap}
body[data-app="chat"] .message.mine .bubble{background:var(--mine);color:#fff;border-color:transparent}
body[data-app="chat"] .message.mentioned .bubble{box-shadow:0 0 0 2px var(--accent2)}
body[data-app="chat"] .message:not(.cont):not(.mine) .bubble{border-top-right-radius:5px}
body[data-app="chat"] .message.mine:not(.cont) .bubble{border-top-left-radius:5px}
body[data-app="chat"] .bubble a{color:inherit;text-decoration:underline}
body[data-app="chat"] .mention{color:var(--accent2);font-weight:800;cursor:pointer}
body[data-app="chat"] .message.mine .mention{color:#fff;text-decoration:underline}
body[data-app="chat"] .quote{border-right:3px solid var(--accent2);padding:2px 9px;margin-bottom:5px;background:#0000001f;border-radius:7px;font-size:12px;cursor:pointer;display:block;max-width:100%}
body[data-app="chat"] .quote b{display:block;color:var(--accent2)}
body[data-app="chat"] .message.mine .quote b{color:#fff}
body[data-app="chat"] .quote span{display:block;opacity:.85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body[data-app="chat"] .meta{display:flex;justify-content:flex-end;gap:6px;font-size:10px;opacity:.7;margin-top:2px}
body[data-app="chat"] .reacts{display:flex;gap:4px;flex-wrap:wrap;margin-top:4px}
body[data-app="chat"] .react{padding:0 8px;border-radius:99px;border:1px solid var(--line);background:var(--panel);font-size:12px;line-height:22px}
body[data-app="chat"] .react.on{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 22%,var(--panel))}
body[data-app="chat"] .tools{display:none;gap:4px;margin-top:4px;flex-wrap:wrap}
body[data-app="chat"] .message:hover .tools,body[data-app="chat"] .message.show .tools,body[data-app="chat"] .message:focus-within .tools{display:flex}
body[data-app="chat"] .tools button{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:1px 8px;font-size:11px}
body[data-app="chat"] .tools button:hover{border-color:var(--accent)}
body[data-app="chat"] .picker{display:none;gap:2px;padding:3px 5px;border:1px solid var(--line);background:var(--panel);border-radius:99px;margin-top:4px;width:fit-content}
body[data-app="chat"] .message.picking .picker{display:flex}
body[data-app="chat"] .picker button{font-size:18px;padding:0 4px;border-radius:8px}
body[data-app="chat"] .message.flash .bubble{animation:flash 1.4s ease}
@keyframes flash{0%,60%{box-shadow:0 0 0 3px var(--accent2)}100%{box-shadow:0 0 0 0 transparent}}
body[data-app="chat"] .down{position:absolute;left:20px;bottom:130px;width:42px;height:42px;border-radius:50%;background:var(--panel);border:1px solid var(--line);box-shadow:var(--shadow);z-index:5}
body[data-app="chat"] .composer{border-top:1px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:var(--panel)}
body[data-app="chat"] .composer-in{width:min(860px,100%);margin:auto}
body[data-app="chat"] .bar{margin-bottom:8px;padding:7px 12px;background:var(--panel2);border-radius:10px;border-right:3px solid var(--accent);display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12px}
body[data-app="chat"] .bar span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
body[data-app="chat"] .box{display:flex;align-items:flex-end;gap:6px;background:var(--field);border:1px solid var(--line);border-radius:18px;padding:5px}
body[data-app="chat"] .box textarea{flex:1;min-width:0;resize:none;min-height:42px;max-height:140px;padding:9px 6px;background:transparent;border:0;border-radius:10px}
body[data-app="chat"] .box textarea:focus{border:0}
body[data-app="chat"] .send{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:var(--accent);color:var(--on-accent);flex-shrink:0;font-size:17px}
body[data-app="chat"] .tool{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;font-size:20px;flex-shrink:0}
body[data-app="chat"] .tool:hover{background:var(--panel2)}
body[data-app="chat"] .emoji{padding:8px;margin-bottom:8px;border:1px solid var(--line);border-radius:15px;background:var(--panel2);display:grid;grid-template-columns:repeat(auto-fill,minmax(38px,1fr));gap:3px;max-height:150px;overflow:auto}
body[data-app="chat"] .emoji button{font-size:22px;padding:3px;border-radius:8px}
body[data-app="chat"] .emoji button:hover{background:var(--panel)}
body[data-app="chat"] .chint{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;padding:4px 5px 0}
body[data-app="chat"] .blocked{padding:13px;text-align:center;color:var(--muted);background:var(--field);border:1px dashed var(--line);border-radius:14px}
body[data-app="chat"] hr{border:0;border-top:1px solid var(--line);margin:14px 0}
body[data-app="chat"] .pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(44px,1fr));gap:6px}
body[data-app="chat"] .pgrid button{font-size:22px;padding:6px;border:1px solid var(--line);border-radius:12px}
body[data-app="chat"] .pgrid button[aria-checked=true]{border-color:var(--accent2);background:var(--panel2)}
@media(max-width:860px){body[data-app="chat"] .auth{grid-template-columns:minmax(0,1fr);gap:22px;padding:20px 14px}
body[data-app="chat"] .hero .demo,body[data-app="chat"] .hero p.lead{display:none}
body[data-app="chat"] .hero h1{font-size:24px;margin:0}
body[data-app="chat"] .hero .brand{margin-bottom:12px}
body[data-app="chat"] .app{grid-template-columns:minmax(0,1fr)}
body[data-app="chat"] .sidebar{position:fixed;inset-block:0;right:0;width:min(330px,90vw);transform:translateX(105%);transition:transform .2s;box-shadow:var(--shadow)}
