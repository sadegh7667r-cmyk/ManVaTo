  let ids = act === 'delsel' ? [...A.sel] : [id];
  if (!ids.length) return;
  if (!(await GK.confirm(`${fa(ids.length)} پیام حذف شود؟`, { title: 'حذف پیام', ok: 'حذف', danger: true }))) return;
  const r = GK.deleteMessages(A.mroom, ids, A.me.id); if (!r.ok) GK.toast(r.error, 'error'); else GK.toast('حذف شد.', 'ok');
  A.sel.clear(); render();
}

/* ---------- گزارش‌ها ---------- */
function reports() {
  const all = GK.get('reports', []), list = all.filter(r => A.rq === 'all' || (A.rq === 'open') === (r.status === 'open'));
  return `<div class="toolbar"><select id="rq" aria-label="فیلتر"><option value="open" ${sel(A.rq, 'open')}>باز</option><option value="closed" ${sel(A.rq, 'closed')}>بسته‌شده</option><option value="all" ${sel(A.rq, 'all')}>همه</option></select>
    ${all.some(r => r.status !== 'open') ? '<button class="btn" data-act="purgerep">پاک کردن گزارش‌های بسته‌شده</button>' : ''}</div>
  ${list.map(r => { const rep = GK.userById(r.reporterId), au = GK.userById(r.authorId), room = GK.roomById(r.roomId); return `<div class="card" data-id="${esc(r.id)}">
    <div class="row wrap"><b>${esc(r.authorName)}</b><span class="muted small">در ${esc(room ? roomName(room) : 'اتاق حذف‌شده')}</span><span class="grow"></span><span class="muted tiny">${esc(GK.ago(r.time))}</span>${r.status === 'open' ? '<span class="tag bad">باز</span>' : '<span class="tag ok">بسته</span>'}</div>
    <p class="gk-p" style="background:var(--field);padding:10px 12px;border-radius:12px">${esc(r.text)}</p>
    <div class="small muted">گزارش از ${esc(rep ? rep.name : 'کاربر حذف‌شده')} · دلیل: ${esc(r.reason)}</div>
    ${r.status === 'open' ? `<div class="acts" style="margin-top:12px"><button class="btn sm danger" data-act="repdel">حذف پیام</button>${au ? '<button class="btn sm danger" data-act="repban">مسدود نویسنده</button><button class="btn sm" data-act="repmute">بی‌صدا کردن</button>' : ''}<button class="btn sm" data-act="repdone">بستن گزارش</button></div>` : ''}</div>`; }).join('') || `<div class="card">${empty('گزارشی وجود ندارد.')}</div>`}`;
}
async function repAct(act, id) {
  if (act === 'purgerep') { GK.set('reports', GK.get('reports', []).filter(r => r.status === 'open')); return render(); }
  const all = GK.get('reports', []), r = all.find(x => x.id === id); if (!r) return render();
  const close = () => { r.status = 'closed'; GK.set('reports', all); };
  if (act === 'repdel') { GK.deleteMessages(r.roomId, [r.msgId], A.me.id); close(); GK.toast('پیام حذف و گزارش بسته شد.', 'ok'); }
  else if (act === 'repdone') close();
  else if (act === 'repban' || act === 'repmute') {
    const u = GK.userById(r.authorId); if (!u) { close(); return render(); }
    if (u.role === 'admin') { GK.toast('مدیر را نمی‌توان مسدود یا بی‌صدا کرد.', 'error'); return; }
    if (act === 'repban') { GK.updateUser(u.id, { status: 'banned', banReason: 'تخلف از قوانین' }); GK.log('ban', `«${u.name}» بر اساس گزارش مسدود شد.`, A.me.id); }
    else { GK.updateUser(u.id, { muted: true }); GK.log('mute', `«${u.name}» بر اساس گزارش بی‌صدا شد.`, A.me.id); }
    close(); GK.toast('انجام شد.', 'ok');
  }
  render();
}

/* ---------- تنظیمات ---------- */
function settings() {
  const s = GK.settings();
  const sw = (id, t, d, v) => `<div class="sw"><div><b>${t}</b><small>${d}</small></div><input type="checkbox" id="${id}" ${v ? 'checked' : ''} style="width:20px;height:20px"></div>`;
  return `<div class="card"><h3>عمومی</h3><div class="form2">
    <div class="field"><label class="lbl" for="s-name">نام سایت</label><input id="s-name" maxlength="30" value="${esc(s.siteName)}"></div>
    <div class="field"><label class="lbl" for="s-max">حداکثر طول پیام (نویسه)</label><input id="s-max" type="number" min="20" max="5000" value="${s.maxLen}"></div>
    <div class="field"><label class="lbl" for="s-slow">حالت آهسته (ثانیه بین پیام‌ها، ۰ = خاموش)</label><input id="s-slow" type="number" min="0" max="3600" value="${s.slowMode}"></div>
    <div class="field"><label class="lbl" for="s-minp">حداقل طول رمز عبور</label><input id="s-minp" type="number" min="4" max="32" value="${s.minPass}"></div></div>
    <div class="field"><label class="lbl" for="s-wel">پیام خوش‌آمدگویی</label><textarea id="s-wel" rows="2" maxlength="300">${esc(s.welcome)}</textarea></div></div>
  <div class="card"><h3>دسترسی‌ها</h3>
    ${sw('s-reg', 'ثبت‌نام باز باشد', 'اگر خاموش شود کاربر جدید نمی‌تواند حساب بسازد.', s.registrationOpen)}
    ${sw('s-room', 'کاربران بتوانند اتاق بسازند', 'ناظران و مدیران همیشه می‌توانند.', s.allowRoomCreate)}
    ${sw('s-dm', 'پیام خصوصی فعال باشد', 'گفتگوی دو نفره بین اعضا.', s.allowDM)}
    ${sw('s-edit', 'ویرایش پیام مجاز باشد', 'کاربران فقط پیام خودشان را ویرایش می‌کنند.', s.allowEdit)}
    ${sw('s-mnt', 'حالت تعمیر', 'همه‌ی کاربران غیر از مدیران از سیستم خارج می‌شوند.', s.maintenance)}
    <div class="field" style="margin-top:12px"><label class="lbl" for="s-mm">پیام حالت تعمیر</label><input id="s-mm" maxlength="150" value="${esc(s.maintenanceMsg)}"></div></div>
  <div class="card"><h3>فیلتر کلمات ممنوع</h3><div class="field"><label class="lbl" for="s-bw">هر کلمه در یک خط (در پیام‌ها با • جایگزین می‌شود)</label><textarea id="s-bw" rows="5">${esc(s.bannedWords.join('\n'))}</textarea></div></div>
  <button class="btn primary" data-act="savesettings">ذخیره‌ی تنظیمات</button>`;
}
function saveSettings() {
  const g = id => $('#' + id), n = (id, a, b, d) => GK.clamp(parseInt(g(id).value, 10) || d, a, b);
  const name = GK.clean(g('s-name').value);
  if ([...name].length < 2) { GK.toast('نام سایت خیلی کوتاه است.', 'error'); return; }
  GK.saveSettings({
    siteName: name, maxLen: n('s-max', 20, 5000, 700), slowMode: n('s-slow', 0, 3600, 0), minPass: n('s-minp', 4, 32, 6),
    welcome: GK.clean(g('s-wel').value), registrationOpen: g('s-reg').checked, allowRoomCreate: g('s-room').checked, allowDM: g('s-dm').checked,
    allowEdit: g('s-edit').checked, maintenance: g('s-mnt').checked, maintenanceMsg: GK.clean(g('s-mm').value) || GK.DEFAULTS.maintenanceMsg,
    bannedWords: [...new Set(g('s-bw').value.split('\n').map(x => GK.clean(x)).filter(Boolean))].slice(0, 200)
  });
  GK.log('settings', 'تنظیمات سایت ذخیره شد.', A.me.id); GK.toast('تنظیمات ذخیره شد.', 'ok'); render();
}

/* ---------- گزارش فعالیت ---------- */
function logs() {
  const q = GK.normName(A.lq), list = GK.get('logs', []).filter(l => !q || GK.normName(l.detail + ' ' + l.actor + ' ' + l.action).includes(q)).slice(0, 300);
  return `<div class="toolbar"><input id="lq" placeholder="جستجو در فعالیت‌ها…" value="${esc(A.lq)}" aria-label="جستجو"><button class="btn danger" data-act="clearlogs">پاک کردن گزارش‌ها</button></div>
  <div class="tblwrap"><table><thead><tr><th>زمان</th><th>انجام‌دهنده</th><th>رویداد</th></tr></thead><tbody>
  ${list.map(l => `<tr><td class="small">${esc(GK.dateTime(l.t))}</td><td>${esc(l.actor)}</td><td>${esc(l.detail || l.action)} <span class="tag">${esc(l.action)}</span></td></tr>`).join('')}</tbody></table>${list.length ? '' : empty('رویدادی ثبت نشده.')}</div>`;
}

/* ---------- پشتیبان‌گیری ---------- */
function backup() {
  const ex = GK.exportAll();
  return `<div class="card"><h3>پشتیبان کامل</h3><p class="muted">شامل کاربران، اتاق‌ها، پیام‌ها، تنظیمات، گزارش‌ها و فعالیت‌ها. رمزها به‌صورت هش‌شده ذخیره می‌شوند. (${fa(Object.keys(ex.data).length)} بخش)</p>
    <div class="acts"><button class="btn primary" data-act="export">📥 دانلود پشتیبان</button><button class="btn" data-act="import">📤 بازگردانی از فایل</button></div>
    <input type="file" id="file" accept="application/json,.json" hidden></div>
  <div class="card"><h3>ابزار داده‌ی نمایشی</h3><p class="muted">چند کاربر و پیام نمونه می‌سازد تا پنل را آزمایش کنی (رمز همه‌ی کاربران نمایشی: demo1234).</p><button class="btn" data-act="demo">ساخت داده‌ی نمایشی</button></div>
  <div class="card" style="border-color:color-mix(in srgb,var(--danger) 50%,transparent)"><h3 style="color:var(--danger)">منطقه‌ی خطر</h3><p class="muted">حذف همه‌ی داده‌ها، از جمله حساب مدیر. این کار برگشت‌پذیر نیست؛ ابتدا پشتیبان بگیر.</p><button class="btn danger" data-act="reset">پاک کردن همه‌چیز</button></div>`;
}
async function backAct(act) {
  if (act === 'export') { GK.download('gapkhane-backup-' + new Date().toISOString().slice(0, 10) + '.json', JSON.stringify(GK.exportAll())); GK.log('backup', 'پشتیبان دانلود شد.', A.me.id); GK.toast('پشتیبان آماده شد.', 'ok'); }
  else if (act === 'import') $('#file').click();
  else if (act === 'demo') {
    const names = [['sara', 'سارا'], ['armin', 'آرمین'], ['nika', 'نیکا'], ['reza', 'رضا']];
    for (const [u, n] of names) if (!GK.userByName(u)) await GK.createUser({ username: u, name: n, password: 'demo1234', color: GK.COLORS[Math.floor(Math.random() * GK.COLORS.length)] }, { bypassClosed: true });
    const room = GK.rooms().find(r => r.type !== 'dm'), lines = ['سلام به همه 👋', 'امروز چه خبر؟', 'من یه ایده برای پروژه دارم ✨', 'عالیه، تعریف کن!', 'فردا شب دورهمی آنلاین داریم 🎉'];
    if (room) { const arr = GK.msgs(room.id).slice(); const base = Date.now() - 36e5; names.forEach(([u], i) => { const us = GK.userByName(u); if (us) arr.push({ id: 'm_' + GK.uid(), roomId: room.id, userId: us.id, name: us.name, color: us.color, text: lines[i % lines.length], time: base + i * 6e4, replyTo: null, edited: 0, reactions: {} }); }); GK.set('msgs:' + room.id, arr); }
    GK.log('demo', 'داده‌ی نمایشی ساخته شد.', A.me.id); GK.toast('داده‌ی نمایشی ساخته شد.', 'ok'); render();
  } else if (act === 'reset') {
    const t = await GK.prompt({ title: 'پاک کردن همه‌چیز', label: 'برای تأیید عبارت RESET را بنویس', ok: 'پاک کن', maxlength: 10, validate: v => v.trim() === 'RESET' ? '' : 'عبارت درست نیست.' });
    if (t === null) return; GK.resetAll(); GK.seed(); location.reload();
  }
}
$('#content').addEventListener('change', async e => {
  if (e.target.id === 'file') {
    const f = e.target.files[0]; if (!f) return; e.target.value = '';
    if (f.size > 20 * 1024 * 1024) { GK.toast('فایل خیلی بزرگ است.', 'error'); return; }
    let obj; try { obj = JSON.parse(await f.text()); } catch { GK.toast('فایل JSON معتبر نیست.', 'error'); return; }
    if (!(await GK.confirm('همه‌ی داده‌های فعلی با محتوای این فایل جایگزین می‌شود. ادامه می‌دهی؟', { title: 'بازگردانی پشتیبان', ok: 'بازگردانی', danger: true }))) return;
    const r = GK.importAll(obj); if (!r.ok) { GK.toast(r.error, 'error'); return; }
    GK.clearAdminSession(); GK.toast('بازگردانی انجام شد؛ دوباره وارد شو.', 'ok'); setTimeout(() => location.reload(), 900);
  } else if (e.target.id === 'uf') { A.uf = e.target.value; render(); }
  else if (e.target.id === 'rq') { A.rq = e.target.value; render(); }
  else if (e.target.id === 'mr') { A.mroom = e.target.value; A.sel.clear(); render(); }
  else if (e.target.dataset.sel) { e.target.checked ? A.sel.add(e.target.dataset.sel) : A.sel.delete(e.target.dataset.sel); render(); }
});
function keepFocus(id, key, val) {
  A[key] = val; render(); const el = $('#' + id); if (el) { el.focus(); el.setSelectionRange(el.value.length, el.value.length); }
}
$('#content').addEventListener('input', e => {
  const m = { uq: 'uq', mq: 'mq', lq: 'lq' }[e.target.id]; if (m) keepFocus(e.target.id, m, e.target.value);
});
$('#content').addEventListener('click', async e => {
  const b = e.target.closest('[data-act]'); if (!b || b.disabled) return;
  const act = b.dataset.act, row = b.closest('[data-id]'), id = row ? row.dataset.id : null;
  b.disabled = true;
  try {
    if (['newuser', 'edituser', 'ban', 'unban', 'mute', 'resetpw', 'deluser'].includes(act)) await userAct(act, id);
    else if (['newroom', 'editroom', 'lockroom', 'viewroom', 'clearroom', 'delroom'].includes(act)) await roomAct(act, id);
    else if (['delmsg', 'delsel'].includes(act)) await msgAct(act, id);
    else if (['repdel', 'repban', 'repmute', 'repdone', 'purgerep'].includes(act)) await repAct(act, id);
    else if (act === 'savesettings') saveSettings();
    else if (act === 'clearlogs') { if (await GK.confirm('همه‌ی گزارش فعالیت‌ها پاک شود؟', { ok: 'پاک کن', danger: true })) { GK.set('logs', []); render(); } }
    else await backAct(act);
  } catch (err) { console.error(err); GK.toast('خطایی رخ داد.', 'error'); }
  b.disabled = false;
});

/* ---------- همگام‌سازی ---------- */
GK.onChange(key => {
  if (!A.me || /^(attempts|lastsend|session|theme)$/.test(key) || key.startsWith('prefs:') || key.startsWith('read:')) return;
  if (key === 'presence' && !['dashboard', 'users'].includes(A.page)) return;
  clearTimeout(A.rt);
  A.rt = setTimeout(() => {
    if (!A.me) return;
    const ae = document.activeElement, typing = ae && /^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName);
    if (document.querySelector('.gk-scrim') || typing || A.page === 'settings') nav(); else render();
  }, 400);
});
setInterval(() => { if (A.me) guard() && A.page === 'dashboard' && !document.querySelector('.gk-scrim') && render(); }, 30000);
window.addEventListener('hashchange', () => { const h = location.hash.slice(1).replace(/^admin-?/, ''); if (A.me && PAGES.some(p => p[0] === h) && h !== A.page) { A.page = h; render(); } });

/* ---------- شروع ---------- */
const m = GK.adminState();
if (m) start(m); else showGate();
}

const ADMIN = location.hash.startsWith('#admin');
document.body.dataset.app = ADMIN ? 'admin' : 'chat';
document.getElementById('adminRoot').hidden = !ADMIN;
document.getElementById('chatRoot').hidden = ADMIN;
addEventListener('hashchange', () => { if (location.hash.startsWith('#admin') !== ADMIN) location.reload(); });
const bootEl = document.getElementById('boot'), bootTxt = document.getElementById('bootTxt');
GK.onStatus(st => { if (!bootEl.hidden) bootTxt.textContent = ({ connecting: 'در حال اتصال به سرور…', online: 'در حال بارگذاری…', offline: 'اتصال برقرار نشد؛ در حال تلاش دوباره…', denied: 'دسترسی به پایگاه‌داده رد شد؛ قوانین Firebase را بررسی کن.' })[st] || ''; });
GK.ready.then(() => { bootEl.hidden = true; if (ADMIN) runAdmin(); else runChat(); });
</script>
</body>
</html>
