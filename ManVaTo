    return true;
  }

  /* ---------- حضور ---------- */
  function heartbeat(userId) {
    const p = get('presence', {}); const t = now();
    for (const k in p) if (t - p[k] > 30 * 864e5) delete p[k];
    p[userId] = t; set('presence', p);
  }
  const lastSeen = u => Math.max(u.lastSeen || 0, get('presence', {})[u.id] || 0);
  const isOnline = id => now() - (get('presence', {})[id] || 0) < 45e3;
  const onlineCount = () => { const p = get('presence', {}); return users().filter(u => now() - (p[u.id] || 0) < 45e3).length; };

  /* ---------- اتاق‌ها ---------- */
  const rooms = () => get('rooms', []);
  const saveRooms = a => set('rooms', a);
  const roomById = id => rooms().find(r => r.id === id) || null;
  function roomsFor(user) {
    return rooms().filter(r => r.type === 'dm' ? (user && r.members.includes(user.id)) : true)
      .sort((a, b) => (a.type === 'dm') - (b.type === 'dm') || a.createdAt - b.createdAt);
  }
  function roomTitle(r, viewerId) {
    if (r.type !== 'dm') return r.name;
    const o = userById(r.members.find(x => x !== viewerId));
    return o ? o.name : 'کاربر حذف‌شده';
  }
  function createRoom({ name, desc = '', icon = '💬', by = null }) {
    name = clean(name).replace(/\s+/g, ' ');
    const l = [...name].length;
    if (l < 3 || l > 30) return fail('نام اتاق باید بین ۳ تا ۳۰ نویسه باشد.');
    if (rooms().some(r => r.type !== 'dm' && normName(r.name) === normName(name))) return fail('اتاقی با این نام وجود دارد.');
    const r = { id: 'r_' + uid(), type: 'room', name, desc: clean(desc).slice(0, 140), icon: clean(icon).slice(0, 4) || '💬', createdBy: by, createdAt: now(), locked: false, pinned: null };
    const a = rooms(); a.push(r); saveRooms(a);
    log('room-create', `اتاق «${name}» ساخته شد.`, by);
    return ok({ room: r });
  }
  function updateRoom(id, patch, by) {
    const a = rooms(); const i = a.findIndex(r => r.id === id); if (i < 0) return fail('اتاق پیدا نشد.');
    if (patch.name !== undefined) {
      patch.name = clean(patch.name).replace(/\s+/g, ' ');
      const l = [...patch.name].length;
      if (l < 3 || l > 30) return fail('نام اتاق باید بین ۳ تا ۳۰ نویسه باشد.');
      if (a.some(r => r.id !== id && r.type !== 'dm' && normName(r.name) === normName(patch.name))) return fail('اتاقی با این نام وجود دارد.');
    }
    if (patch.desc !== undefined) patch.desc = clean(patch.desc).slice(0, 140);
    a[i] = { ...a[i], ...patch }; saveRooms(a);
    log('room-update', `اتاق «${a[i].name}» ویرایش شد.`, by);
    return ok({ room: a[i] });
  }
  function deleteRoom(id, by, silent) {
    const r = roomById(id); if (!r) return false;
    saveRooms(rooms().filter(x => x.id !== id)); del('msgs:' + id); cache.delete(id);
    set('reports', get('reports', []).filter(x => x.roomId !== id));
    if (!silent) log('room-delete', `اتاق «${r.name}» حذف شد.`, by);
    return true;
  }
  function dmRoom(a, b) {
    if (a === b) return null;
    const id = 'dm_' + [a, b].sort().join('_');
