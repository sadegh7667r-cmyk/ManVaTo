  return {
    ready, onStatus, cloud: !!CLOUD,
    COLORS, NAME_RE, persistent, get, set, del, allKeys, usedBytes, onChange, onError, uid, esc, fa, now, normName, clean,
    timeText, dayText, dateText, dateTime, ago, safeColor, clamp, debounce, download, el,
    settings, saveSettings, DEFAULTS,
    users, userById, userByName, updateUser, isMod, isAdmin, roleLabel, createUser, register, login, verifyPass, changePassword, setPassword, randomPassword, deleteUser, validatePass, hasBanned, hasAdmin,
