  }
  function modal(o) {
    const prev = document.activeElement;
    const scrim = el(`<div class="gk-scrim"><div class="gk-modal${o.wide ? ' wide' : ''}" role="dialog" aria-modal="true"><div class="gk-mh"><h3></h3><button type="button" class="btn ghost icon-btn" data-x aria-label="بستن">✕</button></div><div class="gk-mb"></div><div class="gk-mf"></div></div></div>`);
