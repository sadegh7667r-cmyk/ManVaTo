    }
    const arr = msgsFresh(roomId);
    const m = { id: 'm_' + uid(), roomId, userId, name: user.name, color: user.color, text: filterText(text), time: t, replyTo: replyTo && arr.some(x => x.id === replyTo) ? replyTo : null, edited: 0, reactions: {} };
    arr.push(m);
    if (!saveMsgs(roomId, arr)) return fail('ذخیره‌سازی پر است یا در دسترس نیست.');
    lastSend[k] = t;
    if (st.slowMode > 0) { const ls = get('lastsend', {}); ls[k] = t; set('lastsend', ls); }
