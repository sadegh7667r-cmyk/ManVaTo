function queue(k) {
  S.dirty[k] = 1; clearTimeout(queue.t);
  queue.t = setTimeout(() => {
    const d = S.dirty; S.dirty = {}; if (!S.me || !revalidate()) return;
    if (d.rooms) {
      const cur = S.room && GK.roomById(S.room.id);
      if (S.room && !cur) { const f = GK.roomsFor(S.me)[0]; GK.toast('این اتاق حذف شد.'); if (f) { openRoom(f.id); return; } S.room = null; }
      else if (cur) S.room = cur;
      renderPinned(); updateComposer();
    }
    if (d.users || d.settings) { renderMe(); updateComposer(); }
    if (d.rooms || d.users || d.settings || d.msgs) { renderHeader(); renderSidebar(); }
    if (d.msgs || d.users || d.settings || d.rooms) renderMessages();
    if (d.presence) { renderMember(); renderHeader(); }
    if (d.notify) notifyNew(d.notify);
  }, 60);
}
function notifyNew(roomId) {
  const a = GK.msgs(roomId), m = a[a.length - 1]; if (!m || m.userId === S.me.id || m.time <= (S.lastNotified[roomId] || GK.now() - 5000)) return;
  S.lastNotified[roomId] = m.time;
  if (GK.prefs(S.me.id).sound) GK.beep();
  if (!(S.room && S.room.id === roomId && !document.hidden)) {
    const r = GK.roomById(roomId); if (r) GK.toast(`پیام جدید از ${m.name} در ${GK.roomTitle(r, S.me.id) || 'گفتگوی خصوصی'}`);
  }
}
GK.onChange(key => {
  if (!S.me) return;
  if (key === '*') { location.reload(); return; }
  if (key === 'users') queue('users');
  else if (key === 'rooms') queue('rooms');
  else if (key === 'settings') queue('settings');
  else if (key === 'presence') queue('presence');
  else if (key.startsWith('msgs:')) { const id = key.slice(5); if (GK.roomById(id) && GK.roomsFor(S.me).some(r => r.id === id)) { S.dirty.notify = id; queue('msgs'); } }
});
