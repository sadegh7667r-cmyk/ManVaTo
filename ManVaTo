    return t;
  }
  const lastSend = {};
  function checkCanPost(user, room) {
    if (!user || user.status === 'banned') return 'حساب شما مسدود است.';
    if (user.muted) return 'شما توسط مدیر بی‌صدا شده‌اید و نمی‌توانید پیام بفرستید.';
    if (!room) return 'اتاق پیدا نشد.';
    if (room.type === 'dm' && !room.members.includes(user.id)) return 'به این گفتگو دسترسی نداری.';
    if (room.locked && !isMod(user)) return 'این اتاق قفل است و فقط مدیران می‌توانند پیام بفرستند.';
    if (settings().maintenance && !isAdmin(user)) return settings().maintenanceMsg;
    return '';
  }
  function sendMessage(userId, roomId, text, replyTo = null) {
    const user = userById(userId), room = roomById(roomId), st = settings();
    const e = checkCanPost(user, room); if (e) return fail(e);
    text = clean(text);
    if (!text) return fail('پیام خالی است.');
    if ([...text].length > st.maxLen) return fail(`پیام نباید بیش از ${fa(st.maxLen)} نویسه باشد.`);
